# Puerto del servidor HTTP
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Ruta al archivo de base de datos SQLite (archivo local, sin servidor)
DATABASE_PATH=./database.sqlite

# Modo de journal de SQLite: DELETE | WAL | MEMORY | OFF
DB_JOURNAL_MODE=WAL

# Nivel de logs: silent | error | warn | info | debug
LOG_LEVEL=info
